{
	"schemaVersion": 1,
	"id": "panda-occlusion",
	"version": "${version}",
	"name": "Panda Occlusion",
	"description": "Server-side cave culling: underground sections you can't see are sent as stone until you can, and entities you can't see aren't sent at all. Breaks freecam, x-ray and ESP.",
	"authors": [
		"TreeOfSelf"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/occlusion",
		"sources": "https://github.com/TreeOfSelf/PandaOcclusion"
	},
	"license": "CC0-1.0",
	"environment": "server",
	"entrypoints": {
		"main": [
			"me.TreeOfSelf.PandaOcclusion.PandaOcclusion"
		],
		"voicechat": [
			"me.TreeOfSelf.PandaOcclusion.VoicechatCompat"
		]
	},
	"mixins": [
		"panda-occlusion.mixins.json"
	],
	"accessWidener": "panda-occlusion.accesswidener",
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": ">=26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
